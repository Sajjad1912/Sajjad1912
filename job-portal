def search_jobs(q, type_, loc, min_sal, max_sal, approved_only=True, limit=50, offset=0):
    with get_conn() as conn:
        base = []
        params = []
        if approved_only:
            base.append("j.status='approved'")
        if type_:
            base.append("j.type=?"); params.append(type_)
        if loc:
            base.append("j.location=?"); params.append(loc)
        if min_sal is not None:
            base.append("j.salary_min>=?"); params.append(min_sal)
        if max_sal is not None:
            base.append("j.salary_max<=?"); params.append(max_sal)
        where = " AND ".join(base) if base else "1=1"
        if q and USE_FTS:
            sql = f"""
              SELECT j.*
              FROM jobs j
              JOIN jobs_fts f ON f.rowid=j.id
              WHERE f MATCH ? AND {where}
              ORDER BY bm25(f) ASC
              LIMIT ? OFFSET ?"""
            return conn.execute(sql, (q, *params, limit, offset)).fetchall()
        elif q:
            sql = f"""
              SELECT j.* FROM jobs j
              WHERE (j.title LIKE ? OR j.description LIKE ?) AND {where}
              ORDER BY j.created_at DESC
              LIMIT ? OFFSET ?"""
            like = f"%{q}%"
            return conn.execute(sql, (like, like, *params, limit, offset)).fetchall()
        else:
            sql = f"SELECT * FROM jobs j WHERE {where} ORDER BY created_at DESC LIMIT ? OFFSET ?"
            return conn.execute(sql, (*params, limit, offset)).fetchall()

