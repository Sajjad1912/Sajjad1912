        return conn.execute("SELECT * FROM users WHERE id=?", (user_id,)).fetchone()

def upsert_seeker_profile(user_id: int, name: str, phone: str, skills: str, resume_path: str):
    with get_conn() as conn:
        conn.execute(
            """INSERT INTO seeker_profiles(user_id,name,phone,skills,resume_path)
               VALUES(?,?,?,?,?)
               ON CONFLICT(user_id) DO UPDATE SET
                 name=excluded.name, phone=excluded.phone, skills=excluded.skills, resume_path=excluded.resume_path""",
            (user_id, name, phone, skills, resume_path)
        )

