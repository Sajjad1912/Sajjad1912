        ttk.Button(self, text="Back", command=lambda: ctrl.show("SeekerDashboard")).grid(row=0, column=11, padx=6)
        self.tree = ttk.Treeview(self, columns=("id","title","location","type","salary_min","salary_max","status"), show="headings", height=22)
        for c in ("id","title","location","type","salary_min","salary_max","status"):
            self.tree.heading(c, text=c.capitalize())
        self.tree.grid(row=1, column=0, columnspan=12, sticky="nsew")
        self.grid_rowconfigure(1, weight=1)
        ttk.Button(self, text="Apply", command=self.apply).grid(row=2, column=0, pady=6)

    def search(self):
        for r in self.tree.get_children(): self.tree.delete(r)
        try:
            rows = search_jobs(
                self.q.get().strip() or None,
                self.type_.get().strip() or None,
                self.loc.get().strip() or None,
                int(self.min_sal.get().strip()) if self.min_sal.get().strip() else None,
                int(self.max_sal.get().strip()) if self.max_sal.get().strip() else None,
                approved_only=True
            )
            for j in rows:
                self.tree.insert("", "end", values=(j["id"], j["title"], j["location"], j["type"], j["salary_min"], j["salary_max"], j["status"]))
        except Exception as e:
            messagebox.showerror("Search error", str(e))

    def apply(self):
        sel = self.tree.selection()
        if not sel: return
        job_id = int(self.tree.item(sel[0], "values")[0])
        try:
            apply_to_job(job_id, session.user["id"])
            add_notification(session.user["id"], "application_submitted", f"job:{job_id}")
            messagebox.showinfo("OK", "Application submitted.")
        except Exception as e:
            messagebox.showerror("Apply error", str(e))

