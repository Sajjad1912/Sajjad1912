    def __init__(self, parent, ctrl):
        super().__init__(parent); self.ctrl = ctrl
        ttk.Label(self, text="Employers Pending Approval").grid(row=0, column=0, sticky="w")
        self.emp = ttk.Treeview(self, columns=("id","email","company","approved"), show="headings"); 
        for c in ("id","email","company","approved"): self.emp.heading(c, text=c.capitalize())
        self.emp.grid(row=1, column=0, sticky="nsew")
        ttk.Label(self, text="Jobs Pending Approval").grid(row=0, column=1, sticky="w")
        self.jobs = ttk.Treeview(self, columns=("id","title","employer_id"), show="headings")
        for c in ("id","title","employer_id"): self.jobs.heading(c, text=c.capitalize())
        self.jobs.grid(row=1, column=1, sticky="nsew")
        self.grid_rowconfigure(1, weight=1); self.grid_columnconfigure(0, weight=1); self.grid_columnconfigure(1, weight=1)
        btns = ttk.Frame(self); btns.grid(row=2, column=0, columnspan=2, pady=6)
        ttk.Button(btns, text="Approve Employer", command=self.approve_emp).pack(side="left", padx=4)
        ttk.Button(btns, text="Approve Job", command=self.approve_job).pack(side="left", padx=4)
        ttk.Button(btns, text="Refresh", command=self.refresh).pack(side="left", padx=4)

    def on_show(self): self.refresh()

    def refresh(self):
        for r in self.emp.get_children(): self.emp.delete(r)
        for r in self.jobs.get_children(): self.jobs.delete(r)
        with get_conn() as conn:
            for row in conn.execute("""SELECT u.id,u.email,ep.company,ep.approved
                                       FROM users u JOIN employer_profiles ep ON ep.user_id=u.id
                                       WHERE u.role='employer' AND ep.approved=0"""):
                self.emp.insert("", "end", values=(row["id"], row["email"], row["company"], row["approved"]))
            for row in conn.execute("""SELECT id,title,employer_id FROM jobs WHERE status='pending'"""):
                self.jobs.insert("", "end", values=(row["id"], row["title"], row["employer_id"]))

    def approve_emp(self):
        sel = self.emp.selection()
        if not sel: return
        emp_id = int(self.emp.item(sel[0], "values")[0])
        set_employer_approved(emp_id, 1)
        self.refresh()

    def approve_job(self):
        sel = self.jobs.selection()
        if not sel: return
        job_id = int(self.jobs.item(sel[0], "values")[0])
        set_job_status(job_id, "approved")
        self.refresh()

