class SeekerDashboard(ttk.Frame):
    def __init__(self, parent, ctrl):
        super().__init__(parent); self.ctrl = ctrl
        top = ttk.Frame(self); top.grid(row=0, column=0, sticky="ew")
        ttk.Button(top, text="Search Jobs", command=lambda: ctrl.show("SearchFrame")).pack(side="left", padx=4, pady=4)
        ttk.Button(top, text="Edit Profile", command=self.edit_profile).pack(side="left", padx=4, pady=4)
        self.metrics_lbl = ttk.Label(top, text=""); self.metrics_lbl.pack(side="right", padx=8)
        self.tree = ttk.Treeview(self, columns=("job","status","updated"), show="headings", height=20)
        for c, t in zip(("job","status","updated"), ("Job","Status","Updated")):
            self.tree.heading(c, text=t)
        self.tree.grid(row=1, column=0, sticky="nsew")
        self.grid_rowconfigure(1, weight=1); self.grid_columnconfigure(0, weight=1)

    def on_show(self): self.refresh()

    def refresh(self):
        for r in self.tree.get_children(): self.tree.delete(r)
        apps = list_applications_for_seeker(session.user["id"])
        for a in apps:
            self.tree.insert("", "end", values=(a["job_title"], a["status"], a["updated_at"]))
        m = seeker_metrics(session.user["id"])
        self.metrics_lbl.config(text=" | ".join([f"{k}:{v}" for k,v in m.items()]))

    def edit_profile(self):
        top = tk.Toplevel(self); top.title("Seeker Profile")
        name = ttk.Entry(top, width=40); phone = ttk.Entry(top, width=40); skills = ttk.Entry(top, width=60)
        ttk.Label(top, text="Name").grid(row=0, column=0, sticky="w"); name.grid(row=0, column=1)
        ttk.Label(top, text="Phone").grid(row=1, column=0, sticky="w"); phone.grid(row=1, column=1)
        ttk.Label(top, text="Skills").grid(row=2, column=0, sticky="w"); skills.grid(row=2, column=1)
        def save():
            upsert_seeker_profile(session.user["id"], name.get(), phone.get(), skills.get(), "")
            messagebox.showinfo("OK", "Profile saved"); top.destroy()
        def upload():
            try:
                path = pick_and_store_resume(session.user["id"])
                prof = get_seeker_profile(session.user["id"])
                upsert_seeker_profile(session.user["id"], name.get() or (prof["name"] if prof else ""),
                                      phone.get() or (prof["phone"] if prof else ""),
                                      skills.get() or (prof["skills"] if prof else ""), path)
                messagebox.showinfo("OK", "Resume uploaded")
            except Exception as e:
                messagebox.showerror("Upload error", str(e))
        ttk.Button(top, text="Upload Resume", command=upload).grid(row=3, column=0, pady=6)
        ttk.Button(top, text="Save", command=save).grid(row=3, column=1, pady=6)

