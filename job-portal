def employer_metrics(employer_id: int):
    with get_conn() as conn:
        active_jobs = conn.execute(
            "SELECT COUNT(*) c FROM jobs WHERE employer_id=? AND status='approved'", (employer_id,)
        ).fetchone()["c"]
        new_apps = conn.execute(
            "SELECT COUNT(*) c FROM applications a JOIN jobs j ON j.id=a.job_id WHERE j.employer_id=? AND a.created_at>=datetime('now','-7 days')",
            (employer_id,)
        ).fetchone()["c"]
        total_apps = conn.execute(
            "SELECT COUNT(*) c FROM applications a JOIN jobs j ON j.id=a.job_id WHERE j.employer_id=?",
            (employer_id,)
        ).fetchone()["c"]
        shortlisted = conn.execute(
            "SELECT COUNT(*) c FROM applications a JOIN jobs j ON j.id=a.job_id WHERE j.employer_id=? AND a.status='shortlisted'",
            (employer_id,)
        ).fetchone()["c"]
        rate = (shortlisted / total_apps) if total_apps else 0
        return active_jobs, new_apps, rate

def seeker_metrics(seeker_id: int):
    with get_conn() as conn:
        rows = conn.execute(
            "SELECT status, COUNT(*) c FROM applications WHERE seeker_id=? GROUP BY status", (seeker_id,)
        ).fetchall()
        return {r["status"]: r["c"] for r in rows}

