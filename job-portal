class LoginFrame(ttk.Frame):
    def __init__(self, parent, ctrl):
        super().__init__(parent)
        self.ctrl = ctrl
        ttk.Label(self, text="Email").grid(row=0, column=0, sticky="w")
        ttk.Label(self, text="Password").grid(row=1, column=0, sticky="w")
        self.email = ttk.Entry(self, width=40); self.email.grid(row=0, column=1)
        self.pw = ttk.Entry(self, width=40, show="*"); self.pw.grid(row=1, column=1)
        ttk.Button(self, text="Login", command=self.login).grid(row=2, column=0, pady=8, sticky="w")
        ttk.Button(self, text="Register Seeker", command=lambda: ctrl.show("RegisterSeekerFrame")).grid(row=2, column=1, sticky="w")
        ttk.Button(self, text="Register Employer", command=lambda: ctrl.show("RegisterEmployerFrame")).grid(row=2, column=1, sticky="e")
        ttk.Button(self, text="Seed Admin", command=self.seed_admin).grid(row=3, column=0, pady=4, sticky="w")
        ttk.Button(self, text="Settings", command=lambda: ctrl.show("SettingsFrame")).grid(row=3, column=1, sticky="e")

    def seed_admin(self):
        if get_user_by_email("admin@example.com"):
            messagebox.showinfo("Info", "Admin already exists.")
            return
        uid = create_user("admin@example.com", hash_password("admin123"), "admin")
        messagebox.showinfo("OK", f"Admin created: admin@example.com / admin123 (id={uid})")

    def login(self):
        u = get_user_by_email(self.email.get().strip())
        if not u:
            messagebox.showerror("Error", "User not found"); return
        if not verify_password(self.pw.get(), u["password_hash"]):
            messagebox.showerror("Error", "Invalid credentials"); return
        session.user = u
        if u["role"] == "seeker":
            self.ctrl.show("SeekerDashboard")
        elif u["role"] == "employer":
            self.ctrl.show("EmployerDashboard")
        else:
            self.ctrl.show("AdminDashboard")

