class EmployerDashboard(ttk.Frame):
    def __init__(self, parent, ctrl):
        super().__init__(parent); self.ctrl = ctrl
        top = ttk.Frame(self); top.grid(row=0, column=0, sticky="ew")
        ttk.Button(top, text="New Job", command=lambda: ctrl.show("EmployerJobForm")).pack(side="left", padx=4, pady=4)
        ttk.Button(top, text="Refresh", command=self.refresh).pack(side="left", padx=4, pady=4)
        self.metrics_lbl = ttk.Label(top, text=""); self.metrics_lbl.pack(side="right", padx=8)
        self.tree = ttk.Treeview(self, columns=("id","title","status","created"), show="headings", height=18)
        for c in ("id","title","status","created"):
            self.tree.heading(c, text=c.capitalize())
        self.tree.grid(row=1, column=0, sticky="nsew")
        self.grid_rowconfigure(1, weight=1); self.grid_columnconfigure(0, weight=1)
        btns = ttk.Frame(self); btns.grid(row=2, column=0, sticky="w", pady=6)
        ttk.Button(btns, text="Open Applications", command=self.open_apps).pack(side="left", padx=4)
        ttk.Button(btns, text="Mark Pending (request approval)", command=self.request_approve).pack(side="left", padx=4)

    def on_show(self): self.refresh()

    def refresh(self):
        for r in self.tree.get_children(): self.tree.delete(r)
        rows = list_jobs_by_employer(session.user["id"])
        for j in rows:
            self.tree.insert("", "end", values=(j["id"], j["title"], j["status"], j["created_at"]))
        a, n, rate = employer_metrics(session.user["id"])
        self.metrics_lbl.config(text=f"Active:{a} | New apps(7d):{n} | Shortlist rate:{rate:.2f}")

    def open_apps(self):
        sel = self.tree.selection() 
        if not sel: return
        job_id = int(self.tree.item(sel[0], "values")[0])
        top = tk.Toplevel(self); top.title(f"Applications for Job #{job_id}")
        tree = ttk.Treeview(top, columns=("id","seeker","status","created"), show="headings", height=20)
        for c in ("id","seeker","status","created"):
            tree.heading(c, text=c.capitalize())
        tree.pack(fill="both", expand=True)
        def reload():
            for r in tree.get_children(): tree.delete(r)
            for a in list_applications_for_job(job_id):
                tree.insert("", "end", values=(a["id"], a["seeker_email"], a["status"], a["created_at"]))
        def shortlist():
            sel2 = tree.selection()
            if not sel2: return
            app_id = int(tree.item(sel2[0], "values")[0])
            update_application_status(app_id, "shortlisted")
            reload()
        ttk.Button(top, text="Refresh", command=reload).pack(side="left", padx=4, pady=4)
        ttk.Button(top, text="Shortlist", command=shortlist).pack(side="left", padx=4, pady=4)
        reload()

    def request_approve(self):
        sel = self.tree.selection()
        if not sel: return
        job_id = int(self.tree.item(sel[0], "values")[0])
        set_job_status(job_id, "pending")
        messagebox.showinfo("OK", "Job marked as pending admin approval.")

